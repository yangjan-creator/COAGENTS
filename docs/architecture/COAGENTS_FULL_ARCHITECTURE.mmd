  DOMAIN -->|"committed event_id / outbox_id"| OUT
  SCHED -->|"occurrence_id · operation_id"| OUT
  OUT -->|"event_id · recipient · redacted revision"| NOTIFY
  OUT -->|"delivery_id · endpoint revision"| WEBHOOK
  AUTH -.->|"recipient scope / epoch 重驗"| NOTIFY
  AUTH -.->|"endpoint policy / epoch 重驗"| WEBHOOK
  KNOW -->|"exact source revision / context purpose"| DOMAIN
